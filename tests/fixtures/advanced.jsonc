{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "node-a1b2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "node-a1b2",
      "options": {
        "baseURL": "http://node-a1b2.example.invalid:8000/v1"
      },
      "models": {
        "aeon": {
          "name": "aeon",
          "limit": {
            "context": 229376,
            "output": 65536
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          // Qwen3 "thinking" recommended sampling — steadier long agent runs
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20
          }
        }
        // raise context when node-a1b2 gets more VRAM
      }
    },
    "node-c3d4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "node-c3d4",
      "options": {
        "baseURL": "http://node-c3d4.example.invalid:8000/v1"
      },
      "models": {
        "aeon": {
          "name": "qwen3.5-122B-A10B",
          "limit": {
            "context": 196608,
            "output": 65536
          },
          "reasoning": true,
          "tool_call": true,
          "temperature": true,
          // Qwen3 "thinking" recommended sampling — steadier long agent runs
          "options": {
            "temperature": 0.6,
            "top_p": 0.95,
            "top_k": 20
          }
        }
      }
    }
  },
  "agent": {
    "plan": {
      "temperature": 0.8,
      "top_p": 0.9,
      "top_k": 40,
      "reasoning": true,
      "permission": {
        "task": { "*": "deny", "explore": "allow", "scout": "allow", "brainstorm": "allow" }
      }
    },
    "brainstorm": {
      "temperature": 0.8,
      "top_p": 0.95,
      "top_k": 20,
      "reasoning": true
    },
    "build": {
      "temperature": 0.3,
      "top_p": 0.4,
      "top_k": 20,
      "reasoning": true,
      "permission": { 
        "task": { "*": "deny", "explore": "allow", "scout": "ask" }
      } 
    },
    "build_fast": {
      "temperature": 0.2,
      "top_p": 0.2,
      "top_k": 10,
      "reasoning": false
    },
    "qa": {
      "temperature": 1.0,
      "top_p": 0.95,
      "top_k": 50
    },
    "review": {
      "mode": "subagent",
      "temperature": 0.7,
      "top_p": 0.8,
      "top_k": 40,
      "prompt": "{file:./prompts/code-test-quality-review.md}"
    },
    "techwriter": {
      "temperature": 0.45,
      "top_p": 0.85,
      "top_k": 20,
      "prompt": "{file:./prompts/docs-writer.md}"
    }
  }
}
